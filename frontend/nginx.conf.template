server {
    listen 3000;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/x-font-ttf image/svg+xml;
    gzip_min_length 256;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass __API_PROXY_TARGET__;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Host __API_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
        # Required for SSE (Server-Sent Events) streaming — disable buffering so
        # chat events arrive at the browser in real time instead of after the response ends.
        proxy_buffering off;
        proxy_cache off;
        proxy_ssl_server_name on;
    }

    location /ws {
        proxy_pass __API_PROXY_TARGET__;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host __API_HOST__;
        proxy_read_timeout 86400s;
        proxy_ssl_server_name on;
    }

    location /presenton-proxy/ {
        rewrite ^/presenton-proxy/(.*)$ /$1 break;
        proxy_pass __PRESENTON_PROXY_TARGET__;
        proxy_redirect off;
        proxy_set_header Host __PRESENTON_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        proxy_ssl_server_name on;
    }
}
