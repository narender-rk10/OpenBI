# MongoDB — OpenBI uses an EXTERNAL MongoDB (there is no mongo container in
# docker-compose). Point this at your managed Atlas cluster or any reachable
# MongoDB. Example Atlas URI:
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/openbi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/openbi
MONGODB_DB_NAME=openbi

# JWT
JWT_SECRET_KEY=change-me-to-random-64-char-string-openbi-2024-secure-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MindsDB (internal Docker network URL — never expose publicly)
MINDSDB_URL=http://mindsdb:47334

# LLM provider/model/API key are configured via the UI (Settings → LLM) and
# stored in MongoDB. There are no .env defaults — every org configures its own.

# Redis (for WebSocket pub/sub + Celery)
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# File uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# PDF Export
PDF_FONT=Inter

# Super Admin (first user created on startup)
SUPER_ADMIN_EMAIL=admin@openbi.dev
SUPER_ADMIN_PASSWORD=changeme123

# SMTP (for email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@openbi.dev

# App URL (for links in emails/telegram)
APP_URL=http://localhost:3000

# Fernet encryption key (for API key encryption)
FERNET_KEY=your-fernet-key-base64-encoded
